# =============================================
# CRIANZA CON AMOR - Variables de entorno
# Copia este archivo como .env y completa los valores
# =============================================

# ---- MERCADO PAGO ----
# Obtén tu Access Token en: https://www.mercadopago.com.pe/settings/account/credentials
MP_ACCESS_TOKEN=APP_USR-tu-access-token-aqui
MP_PUBLIC_KEY=APP_USR-tu-public-key-aqui

# ---- CONFIGURACIÓN DEL SITIO ----
# URL donde está desplegado tu sitio (sin barra final)
BASE_URL=https://tudominio.com
PORT=3000

# ---- EMAIL (para enviar los ebooks) ----
# Usa Gmail con una "Contraseña de aplicación" (no tu contraseña normal)
# Guía: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tuemail@gmail.com
EMAIL_PASS=tu-contrasena-de-aplicacion
EMAIL_FROM=Crianza con Amor <tuemail@gmail.com>

# ---- LINKS DE DESCARGA DE LOS EBOOKS ----
# Sube tus PDFs a Google Drive y pon el link de descarga directa
# Para obtener link directo de Drive: Compartir > Cualquier persona con el link > Copiar link
# Luego reemplaza /file/d/ID/view por /uc?export=download&id=ID
DOWNLOAD_URL_SUENO=https://drive.google.com/uc?export=download&id=TU_ID_ARCHIVO_SUENO
DOWNLOAD_URL_ALIMENTACION=https://drive.google.com/uc?export=download&id=TU_ID_ARCHIVO_ALIMENTACION
DOWNLOAD_URL_EMOCIONES=https://drive.google.com/uc?export=download&id=TU_ID_ARCHIVO_EMOCIONES
DOWNLOAD_URL_BONUS_LIMITES=https://drive.google.com/uc?export=download&id=TU_ID_ARCHIVO_BONUS
