# =============================================
# CRIANZA CON AMOR - Variables de entorno
# Copia este archivo como .env y completa los valores
# =============================================

# ---- MERCADO PAGO ----
# Obtén tu Access Token en: https://www.mercadopago.com.pe/settings/account/credentials
MP_ACCESS_TOKEN=APP_USR-tu-access-token-aqui
MP_PUBLIC_KEY=APP_USR-tu-public-key-aqui

# ---- CONFIGURACIÓN DEL SITIO ----
# URL donde está desplegado tu sitio (sin barra final)
BASE_URL=https://tudominio.com
PORT=3000

# ---- EMAIL (para enviar los ebooks) ----
# Usa Gmail con una "Contraseña de aplicación" (no tu contraseña normal)
# Guía: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tuemail@gmail.com
EMAIL_PASS=tu-contrasena-de-aplicacion
EMAIL_FROM=Crianza con Amor <tuemail@gmail.com>

# ---- LINK DE DESCARGA DEL EBOOK ----
# Sube tu PDF a Google Drive y pon el link de descarga directa
# Cómo obtener el link:
#   1. Sube el PDF a Google Drive
#   2. Clic derecho → Compartir → Cualquier persona con el link
#   3. Copia el link (tiene la forma: https://drive.google.com/file/d/XXXXXXX/view)
#   4. Reemplaza la parte final: cambia /file/d/XXXXXXX/view por /uc?export=download&id=XXXXXXX
DOWNLOAD_URL_EBOOK=https://drive.google.com/uc?export=download&id=TU_ID_DEL_ARCHIVO_PDF
